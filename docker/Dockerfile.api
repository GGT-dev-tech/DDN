FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project

COPY apps/api_gateway/src ./apps/api_gateway/src

# Set PYTHONPATH so absolute imports work from the root of /app
ENV PYTHONPATH=/app

CMD ["uv", "run", "uvicorn", "apps.api_gateway.src.main:app", "--host", "0.0.0.0", "--port", "8000"]
